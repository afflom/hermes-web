# Dockerfile.riscv64 — the Hermes agent runtime as a linux/riscv64 OCI image: the guest userland for the
# holospaces emulator (Stage B / HL-B). Booted under the in-browser RISC-V emulator; its filesystem is
# ingested into the content-addressed κ-disk (the same OCI→ext4 path holospaces' CC-10/CC-33 witness).
#
# TWO STAGES so the runtime image carries only what the guest needs at runtime:
#   builder  — compiles + installs the wheels (build-essential + rust + -dev headers; heavy, cached)
#   runtime  — the base python + runtime libs + the installed site-packages + the source. No gcc/rust/
#              headers, so the κ-disk (and the in-memory ext4 the witness assembles) stays small enough
#              to ingest + boot.
#
# Build (needs docker buildx + riscv64 binfmt — `docker run --privileged tonistiigi/binfmt --install riscv64`):
#   tools/holo/build-guest-image.sh

# ─────────────────────────── builder ───────────────────────────
FROM riscv64/python:3.11-slim AS builder

ENV DEBIAN_FRONTEND=noninteractive \
    PIP_NO_CACHE_DIR=1 \
    PYTHONUNBUFFERED=1 \
    CARGO_HOME=/usr/local/cargo \
    RUSTUP_HOME=/usr/local/rustup \
    PATH=/usr/local/cargo/bin:$PATH \
    HERMES_HOME=/root/.hermes

# Build toolchain the exact-pinned dependency set needs to compile from source on riscv64, where some
# Rust-backed wheels (cryptography) and C extensions (Pillow → zlib/jpeg/freetype/webp; cffi → ffi)
# have no prebuilt riscv64 wheel. (node `nodejs` runtime only — NOT Debian's `npm`, which pulls ~640
# `node-*` packages of packaging cruft.)
RUN apt-get update && apt-get install -y --no-install-recommends \
      git ripgrep ffmpeg nodejs ca-certificates curl \
      build-essential pkg-config libssl-dev libffi-dev \
      zlib1g-dev libjpeg-dev libfreetype-dev libwebp-dev \
 && rm -rf /var/lib/apt/lists/*

RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs \
      | sh -s -- -y --no-modify-path --profile minimal --default-toolchain stable

WORKDIR /opt/hermes
COPY . /opt/hermes

# Install Hermes (hermes-agent, exact-pinned core deps from pyproject) + the dashboard server deps.
RUN python -m pip install --upgrade pip \
 && python -m pip install . fastapi "uvicorn[standard]"

# ─────────────────────────── runtime ───────────────────────────
FROM riscv64/python:3.11-slim

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    HERMES_HOME=/root/.hermes

# Runtime tools the agent shell uses (plan §1.4) + the shared libraries the compiled wheels link against
# (Pillow → libjpeg/freetype/webp; libssl3/zlib1g/libffi come with the base python). No compilers.
RUN apt-get update && apt-get install -y --no-install-recommends \
      git ripgrep ffmpeg nodejs ca-certificates \
      libjpeg62-turbo libfreetype6 libwebp7 \
 && rm -rf /var/lib/apt/lists/*

# The installed packages + entry scripts from the builder — no build toolchain travels into the runtime.
COPY --from=builder /usr/local/lib/python3.11/site-packages /usr/local/lib/python3.11/site-packages
COPY --from=builder /usr/local/bin /usr/local/bin

WORKDIR /opt/hermes
COPY . /opt/hermes

EXPOSE 9119
# The in-guest dashboard server the hologram transport reaches over the loopback bridge (HL-C).
# `dashboard` is the real subcommand (`web` does not exist); --insecure binds non-localhost so the host
# can dial it; --skip-build serves the prebuilt UI dist (hermes_cli/web_dist) instead of running npm.
CMD ["python", "-m", "hermes_cli.main", "dashboard", "--host", "0.0.0.0", "--port", "9119", "--insecure", "--no-open", "--skip-build"]
