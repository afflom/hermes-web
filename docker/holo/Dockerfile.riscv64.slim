# syntax=docker/dockerfile:1
# Dockerfile.riscv64.slim — assemble the slim Hermes guest runtime by COPYing the already-built,
# riscv64-compiled site-packages out of the fat image (build context `fat`), so NOTHING recompiles.
# Pair with tools/holo/build-guest-image-slim.sh, which passes the fat OCI layout as the `fat` context.
# The result carries only the runtime: base python + runtime libs + installed packages + the source.
FROM riscv64/python:3.11-slim

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    HERMES_HOME=/root/.hermes

# Runtime tools (plan §1.4) + the shared libs the compiled wheels link against (Pillow → jpeg/freetype/
# webp; libssl3/zlib1g/libffi come with the base python). No compilers.
RUN apt-get update && apt-get install -y --no-install-recommends \
      git ripgrep ffmpeg nodejs ca-certificates \
      libjpeg62-turbo libfreetype6 libwebp7 \
 && rm -rf /var/lib/apt/lists/*

# The already-compiled packages + entry scripts from the fat image — no pip, no toolchain.
COPY --from=fat /usr/local/lib/python3.11/site-packages /usr/local/lib/python3.11/site-packages
COPY --from=fat /usr/local/bin /usr/local/bin

WORKDIR /opt/hermes
COPY . /opt/hermes

EXPOSE 9119
# `dashboard` is the real subcommand; --insecure binds non-localhost (host dials it); --skip-build
# serves the prebuilt UI dist (hermes_cli/web_dist) instead of running npm.
CMD ["python", "-m", "hermes_cli.main", "dashboard", "--host", "0.0.0.0", "--port", "9119", "--insecure", "--no-open", "--skip-build"]
