+/// A [`StreamRead`] over an OPFS file (the reassembled κ-snapshot the worker wrote). Reads sequentially
+/// via the sync access handle so `restore_net_streamed` never holds the whole 1.44 GB in the wasm heap.
+struct OpfsReader {
+    handle: web_sys::FileSystemSyncAccessHandle,
+    pos: f64,
+    size: f64,
+}
+impl OpfsReader {
+    fn new(handle: web_sys::FileSystemSyncAccessHandle) -> Result<Self, JsValue> {
+        let size = handle.get_size()?;
+        Ok(OpfsReader { handle, pos: 0.0, size })
+    }
+}
+impl StreamRead for OpfsReader {
+    fn read_exact(&mut self, buf: &mut [u8]) -> Result<(), SnapshotError> {
+        if self.pos + buf.len() as f64 > self.size {
+            return Err(SnapshotError::Truncated);
+        }
+        // The sync access handle can return a short read; loop until `buf` is full.
+        let mut filled = 0usize;
+        while filled < buf.len() {
+            let opts = web_sys::FileSystemReadWriteOptions::new();
+            opts.set_at(self.pos + filled as f64);
+            let n = self
+                .handle
+                .read_with_u8_array_and_options(&mut buf[filled..], &opts)
+                .map_err(|_| SnapshotError::Truncated)? as usize;
+            if n == 0 {
+                return Err(SnapshotError::Truncated);
+            }
+            filled += n;
+        }
+        self.pos += buf.len() as f64;
+        Ok(())
+    }
+    fn read_to_end(&mut self) -> Result<Vec<u8>, SnapshotError> {
+        let remaining = (self.size - self.pos) as usize;
+        let mut v = vec![0u8; remaining];
+        let mut filled = 0usize;
+        while filled < remaining {
+            let opts = web_sys::FileSystemReadWriteOptions::new();
+            opts.set_at(self.pos + filled as f64);
+            let n = self
+                .handle
+                .read_with_u8_array_and_options(&mut v[filled..], &opts)
+                .map_err(|_| SnapshotError::Truncated)? as usize;
+            if n == 0 {
+                break;
+            }
+            filled += n;
+        }
+        v.truncate(filled);
+        self.pos = self.size;
+        Ok(v)
+    }
+}
