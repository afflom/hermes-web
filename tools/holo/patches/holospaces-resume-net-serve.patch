+/// A [`StreamRead`] over an OPFS file (the reassembled κ-snapshot the worker wrote). Reads sequentially
+/// via the sync access handle so `restore_net_streamed` never holds the whole 1.44 GB in the wasm heap.
+///
+/// BLOCK-BUFFERED: the streamed restore reads the disk one 512-byte sector at a time (~1.7 M reads for
+/// the 900 MB disk). Issuing a separate OPFS syscall per sector makes resume crawl; instead we pull the
+/// file in `READ_BLOCK` chunks and serve `read_exact` from that buffer, cutting OPFS reads ~8000×.
+struct OpfsReader {
+    handle: web_sys::FileSystemSyncAccessHandle,
+    pos: f64,  // logical bytes consumed from the file
+    size: f64,
+    buf: Vec<u8>,   // a contiguous window of the file starting at `buf_base`
+    buf_base: f64,  // file offset of buf[0]
+}
+const READ_BLOCK: usize = 4 * 1024 * 1024; // 4 MiB OPFS reads amortize per-sector restore reads
+impl OpfsReader {
+    fn new(handle: web_sys::FileSystemSyncAccessHandle) -> Result<Self, JsValue> {
+        let size = handle.get_size()?;
+        Ok(OpfsReader { handle, pos: 0.0, size, buf: Vec::new(), buf_base: 0.0 })
+    }
+    /// Read exactly `out.len()` bytes from OPFS at `at`, looping over short reads.
+    fn read_at(&self, at: f64, out: &mut [u8]) -> Result<(), SnapshotError> {
+        let mut filled = 0usize;
+        while filled < out.len() {
+            let opts = web_sys::FileSystemReadWriteOptions::new();
+            opts.set_at(at + filled as f64);
+            let n = self
+                .handle
+                .read_with_u8_array_and_options(&mut out[filled..], &opts)
+                .map_err(|_| SnapshotError::Truncated)? as usize;
+            if n == 0 {
+                return Err(SnapshotError::Truncated);
+            }
+            filled += n;
+        }
+        Ok(())
+    }
+}
+/// A [`StreamRead`] fed by a JS callback that returns the next chunk of the snapshot — the worker slices
+/// its in-memory snapshot and hands wasm one window at a time. This lets `restore_net_streamed` parse the
+/// snapshot into RAM + an in-wasm MemKappaStore WITHOUT the monolithic `&[u8]` resume's full 1.44 GB copy
+/// in the wasm heap (the ~2.7 GB peak that trips the wasm32 ceiling and aborts on refresh). No OPFS round
+/// trip — the feed is RAM copies — so it's as fast as the monolithic resume but peaks at ~1.4 GB.
+struct FedReader {
+    next: js_sys::Function, // () -> Uint8Array (a zero-length array signals EOF)
+    buf: Vec<u8>,
+    consumed: usize,
+    eof: bool,
+}
+impl FedReader {
+    fn new(next: js_sys::Function) -> Self {
+        FedReader { next, buf: Vec::new(), consumed: 0, eof: false }
+    }
+    fn refill(&mut self) -> Result<(), SnapshotError> {
+        if self.eof {
+            return Ok(());
+        }
+        let chunk = self.next.call0(&JsValue::NULL).map_err(|_| SnapshotError::Truncated)?;
+        let arr = js_sys::Uint8Array::new(&chunk);
+        let len = arr.length() as usize;
+        if len == 0 {
+            self.eof = true;
+            return Ok(());
+        }
+        self.buf = vec![0u8; len];
+        arr.copy_to(&mut self.buf);
+        self.consumed = 0;
+        Ok(())
+    }
+}
+impl StreamRead for FedReader {
+    fn read_exact(&mut self, out: &mut [u8]) -> Result<(), SnapshotError> {
+        let mut filled = 0usize;
+        while filled < out.len() {
+            if self.consumed >= self.buf.len() {
+                self.refill()?;
+                if self.consumed >= self.buf.len() {
+                    return Err(SnapshotError::Truncated); // EOF before the request was satisfied
+                }
+            }
+            let n = (self.buf.len() - self.consumed).min(out.len() - filled);
+            out[filled..filled + n].copy_from_slice(&self.buf[self.consumed..self.consumed + n]);
+            self.consumed += n;
+            filled += n;
+        }
+        Ok(())
+    }
+    fn read_to_end(&mut self) -> Result<Vec<u8>, SnapshotError> {
+        let mut v = Vec::new();
+        v.extend_from_slice(&self.buf[self.consumed..]);
+        self.consumed = self.buf.len();
+        loop {
+            self.refill()?;
+            if self.eof || self.buf.is_empty() {
+                break;
+            }
+            v.extend_from_slice(&self.buf);
+            self.consumed = self.buf.len();
+        }
+        Ok(v)
+    }
+}
+impl StreamRead for OpfsReader {
+    fn read_exact(&mut self, out: &mut [u8]) -> Result<(), SnapshotError> {
+        if self.pos + out.len() as f64 > self.size {
+            return Err(SnapshotError::Truncated);
+        }
+        let mut filled = 0usize;
+        while filled < out.len() {
+            let off = (self.pos - self.buf_base) as i64;
+            if off < 0 || off as usize >= self.buf.len() {
+                // Refill the window at the current position (bounded by EOF).
+                let want = ((self.size - self.pos) as usize).min(READ_BLOCK);
+                let mut tmp = vec![0u8; want];
+                self.read_at(self.pos, &mut tmp)?;
+                self.buf = tmp;
+                self.buf_base = self.pos;
+            }
+            let off = (self.pos - self.buf_base) as usize;
+            let n = (self.buf.len() - off).min(out.len() - filled);
+            out[filled..filled + n].copy_from_slice(&self.buf[off..off + n]);
+            filled += n;
+            self.pos += n as f64;
+        }
+        Ok(())
+    }
+    fn read_to_end(&mut self) -> Result<Vec<u8>, SnapshotError> {
+        let remaining = (self.size - self.pos) as usize;
+        let mut v = Vec::with_capacity(remaining);
+        // Drain any bytes already in the window, then read the rest straight through.
+        let off = (self.pos - self.buf_base) as i64;
+        if off >= 0 && (off as usize) < self.buf.len() {
+            v.extend_from_slice(&self.buf[off as usize..]);
+            self.pos += (self.buf.len() - off as usize) as f64;
+        }
+        let rest = (self.size - self.pos) as usize;
+        if rest > 0 {
+            let start = v.len();
+            v.resize(start + rest, 0);
+            self.read_at(self.pos, &mut v[start..])?;
+            self.pos = self.size;
+        }
+        Ok(v)
+    }
