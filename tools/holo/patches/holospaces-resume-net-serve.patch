+/// A sequential byte source for **streaming restore** ([`Emulator::restore_net_streamed`]) — a slice
+/// cursor natively/in tests, an OPFS file handle in the browser peer. It lets a resumed machine read its
+/// κ-snapshot WITHOUT ever holding the whole 1.44 GB in the wasm heap: the big disk section streams
+/// sector-by-sector into a (possibly OPFS-backed) κ-store, and only RAM + the sparse disk index stay
+/// resident. `read_exact` fills `buf` from the current position; `read_to_end` returns the remainder.
+pub trait StreamRead {
+    /// Fill `buf` completely from the current position, advancing it; error if fewer bytes remain.
+    fn read_exact(&mut self, buf: &mut [u8]) -> Result<(), SnapshotError>;
+    /// Return all bytes from the current position to the end (the trailing RAM image).
+    fn read_to_end(&mut self) -> Result<Vec<u8>, SnapshotError>;
+}
+
+/// A [`StreamRead`] over an in-memory slice (native + the differential tests).
+pub struct SliceRead<'a> {
+    bytes: &'a [u8],
+    pos: usize,
+}
+impl<'a> SliceRead<'a> {
+    #[must_use]
+    pub fn new(bytes: &'a [u8]) -> Self {
+        SliceRead { bytes, pos: 0 }
+    }
+}
+impl StreamRead for SliceRead<'_> {
+    fn read_exact(&mut self, buf: &mut [u8]) -> Result<(), SnapshotError> {
+        let end = self.pos.checked_add(buf.len()).ok_or(SnapshotError::Truncated)?;
+        if end > self.bytes.len() {
+            return Err(SnapshotError::Truncated);
+        }
+        buf.copy_from_slice(&self.bytes[self.pos..end]);
+        self.pos = end;
+        Ok(())
+    }
+    fn read_to_end(&mut self) -> Result<Vec<u8>, SnapshotError> {
+        let v = self.bytes[self.pos..].to_vec();
+        self.pos = self.bytes.len();
+        Ok(v)
+    }
+}
