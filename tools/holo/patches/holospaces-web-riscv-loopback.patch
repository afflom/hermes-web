+    /// Resume like [`resume_devcontainer`](Workspace::resume_devcontainer), but ALSO re-attach the
+    /// in-process loopback **ingress** bridge (ADR-020, `CC-33`) so the host can immediately
+    /// [`dial_guest`](Workspace::dial_guest) the resumed guest's listening server — the warm Hermes
+    /// dashboard on :9119, already past kernel boot + the Python import. This is the warm-start twin of
+    /// [`boot_devcontainer_routed_opfs_streamed_bridged`](Workspace::boot_devcontainer_routed_opfs_streamed_bridged):
+    /// resume a κ-snapshot instead of cold-booting, then re-enable the bridge. The whole point of the
+    /// exploit — the interpreted boot+import is paid once (when the snapshot was taken), and every
+    /// launch resumes the warm dashboard the transport can dial straight away.
+    pub fn resume_devcontainer_bridged(snapshot: &[u8]) -> Result<Workspace, JsValue> {
+        let base = MachineSpec::devcontainer().base;
+        let mut machine = Emulator::restore(base, snapshot).map_err(js_err)?;
+        machine.enable_loopback();
+        Ok(Workspace {
+            machine,
+            store: MemKappaStore::new(),
+            channel: Vec::new(),
+            files: std::collections::BTreeMap::new(),
+            halted: false,
+            console_cursor: 0,
+            router: None,
+        })
+    }
